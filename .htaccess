# =======================================================================
# APACHE / CPANEL OPTIMIZATION & SEO CONFIGURATION — UD. SEPAKAT
# =======================================================================

RewriteEngine On

# 1. FORCE HTTPS & CANONICAL WWW (Redirect http:// and non-www to https://www.udsepakat.my.id)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?udsepakat\.my\.id$ [NC]
RewriteRule ^(.*)$ https://www.udsepakat.my.id/$1 [L,R=301]

# 2. DEFAULT CHARSET
AddDefaultCharset UTF-8

# 3. SECURITY HEADERS
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# 4. GZIP / DEFLATE COMPRESSION (Improves PageSpeed & Google Core Web Vitals)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 5. BROWSER CACHING (Fast Repeat Visits)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
